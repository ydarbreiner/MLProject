# Copy this file to .env and update the values

# Database
DATABASE_URL=postgresql://postgres:password@localhost/pointcloud_viewer

# File Storage
UPLOAD_DIR=uploads
POINTCLOUD_OUTPUT_DIR=pointclouds
MAX_FILE_SIZE=10737418240

# Processing
POTREE_CONVERTER_PATH=/usr/local/bin/PotreeConverter
CHUNK_SIZE=5242880

# CORS
ALLOWED_ORIGINS=["http://localhost:4200", "http://127.0.0.1:4200"]

# API
API_PREFIX=/api